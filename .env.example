# Copy to .env locally. Replace every placeholder before starting a production server.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL
POSTGRES_USER=mahi_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=mahi_remote
DATABASE_URL=postgres://mahi_admin:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@postgres-db:5432/mahi_remote

# Required backend secrets (generate independently; never commit real values)
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_SECRET

# TURN credentials. The TURN_DOMAIN must resolve to your deployed coturn host.
TURN_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_TURN_SECRET
TURN_DOMAIN=turn.example.com
TURN_PORT=3478

# UI live-release signing keys. Generate a NEW ECDSA P-256 pair after rotating
# the compromised key previously present in repository history. Store the
# private PEM as escaped newlines (\\n) in your deployment secret store.
UI_RELEASE_PRIVATE_KEY=SET_NEW_PRIVATE_KEY_PEM_WITH_ESCAPED_NEWLINES
UI_RELEASE_PUBLIC_KEY=SET_MATCHING_PUBLIC_KEY_PEM_WITH_ESCAPED_NEWLINES

# Optional Google AI Studio/Gemini key (not required for core remote control).
# GEMINI_API_KEY=
